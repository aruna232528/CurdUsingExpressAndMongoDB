<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <title>Document</title>
</head>

<body>
    <div class="container mt-5" style="width:800px">
        <div class="card shadow rounded-4 border-4">
            <div class="card-body">
                <div class="text-primary text-center mb-3">
                    <h3>List of Student</h3>
                </div>
                <div class="d-flex justify-content-end mb-3">
                    <a class="btn btn-primary" href="/add-student"><i class="bi bi-person-add"></i>Add New Student</a>
                    
                </div>
                <table class="table table-bordered table-hover ">
                    <thead class="table-dark">
                        <tr>
                            <th>Sr.no</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% var sno=1%>
                        <% students.forEach(student=>{ %>
                        
                        <tr>
                            <td><%=sno++%></td>
                            <td><%=student.fname%></td>
                            <td><%=student.lname%></td>
                            <td><%=student.email%></td>
                            <td><%=student.phone%></td>
                            <td>
                                <a class="text-info" href="show-student/<%=student._id%>"><i class="bi bi-eye-fill" title="show"></i></a>
                                <a class="text-primary" href="update-student/<%=student._id%>"><i class="bi bi-pencil-fill" title="update"></i></a>
                                <a class="text-danger" href="delete-student/<%=student._id%>"><i class="bi bi-trash-fill" title="delete"></i></a>
                            </td>
                        </tr>
                        <%})%>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>

</html>