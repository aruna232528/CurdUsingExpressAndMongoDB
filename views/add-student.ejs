<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <title>Document</title>
</head>

<body>
    <div class="container mt-3" style="width: 650px;">
        <div class="card shadow rounded-4 border-4">
            <div class="card-body">
                <div class="text-center text-primary">
                    <h2>Add New Student Here</h2>
                </div>
                <form action="/add-student" method="POST">
                    <div class="mb-3">
                        <input type="text" name="fname" class="form-control border-primary"
                            placeholder="Enter the first name">

                    </div>
                    <div class="mb-3">
                        <input type="text" name="lname" class="form-control border-primary"
                            placeholder="Enter the last name">

                    </div>
                    <div class="mb-3">
                        <input type="email" name="email" class="form-control border-primary"
                            placeholder="Enter the email">

                    </div>
                    <div class="mb-3">
                        <input type="tel" name="phone" class="form-control border-primary"
                            placeholder="Enter the Phone number">

                    </div>
                    <div class="mb-3">
                        <label for="address">Address</label>
                        <textarea name="address" id="address" class="form-control border-primary"></textarea>
                    </div>
                    <div>
                        <button class="btn btn-primary">Add New Student</button>
                        <a class="btn btn-danger" href="/">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</body>

</html>